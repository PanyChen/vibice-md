#########################################################################################
log                log.ramp
#########################################################################################
# mW model, ramping simulation, LAMMPS

units           real
dimension       3
boundary        p p p
atom_style      full

processors      * * 1

############################################################ READ FILE

read_restart    restart.*.equil

############################################################ INTERACTION

pair_style      hybrid lj/cut 13.0 sw

pair_coeff      * * sw mW.sw mW NULL NULL
pair_coeff      1 2 lj/cut 1.15 2.34        # substrate - mW water, Ead = 6.44 kcal/mole
pair_coeff      1 3 lj/cut 1.15 2.34      # upper wall - mW water, Ead = 6.44 kcal/mole

pair_coeff      2 3 lj/cut 0.0 2.7410       # Pt, here stands for substrate - upper wall

pair_coeff      2 2 lj/cut 15.9751 2.4710       # Pt, substrate - substrate
pair_coeff      3 3 lj/cut 15.9751 2.4710       # Pt, upper wall - upper wall

pair_modify	    shift yes mix arithmetic

neighbor        2.0 bin
neigh_modify    delay 1 check yes

############################################################ GROUPS

## Pre-defined in in.equil
group           water type 1
group           substrate type 2
group           upperwall type 3

############################################################   COMPUTES

compute         Tw water temp/com
compute         Pliquid water pe/atom
compute         Pw water reduce sum c_Pliquid
compute         Kliquid water ke/atom
compute         Kw water reduce sum c_Kliquid

fix             1 substrate setforce 0.0 0.0 0.0        ### constraint on substrate
fix             2 upperwall setforce 0.0 0.0 NULL       ### constraint on topmost wall, allow longitudinal moving

############################################################   ENSEMBLE

fix             upperwallNVE upperwall nve
fix             waterNVT water nvt temp 290.0 220.0 500.0 tchain 10     ### ramping from 290 K to 220 K

############################################################   OUTPUT
timestep        5.0

thermo_style    custom step c_Tw temp c_Pw c_Kw pe etotal vol press lx ly lz
thermo          1000
thermo_modify   flush yes

fix             writeFile all ave/time 1 1 100 c_Tw c_Pw c_Kw file ramp.txt
dump            1 all custom 100000 ramp.lammpstrj id type mol q x y z vx vy vz

run             14000000            ##### 70 ns, cooling rate = 1 K / ns (ref: DOI: 10.1021/ja411507a)
write_restart   restart.*.ramp

unfix           upperwallNVE
unfix           waterNVT
undump          1
unfix           1
unfix           2 
