#########################################################################################
log                log.equil
#########################################################################################
# mW model equilibrating simulation, LAMMPS

units           real
dimension       3
boundary        p p p
atom_style      full

processors      * * 1

############################################################ READ FILE

read_data      250A_IdenWalls.dat

############################################################ INTERACTION

pair_style      hybrid lj/cut 13.0 sw

pair_coeff      * * sw mW.sw mW NULL NULL
pair_coeff      1 2 lj/cut 1.15 2.34        # substrate - mW water, Ead = 6.44 kcal/mole
pair_coeff      1 3 lj/cut 1.15 2.34      # upper wall - mW water, Ead = 6.44 kcal/mole

pair_coeff      2 3 lj/cut 0.0 2.7410       # Pt, here stands for substrate - upper wall

pair_coeff      2 2 lj/cut 15.9751 2.4710       # Pt, substrate - substrate
pair_coeff      3 3 lj/cut 15.9751 2.4710       # Pt, upper wall - upper wall

pair_modify	    shift yes mix arithmetic

neigh_modify    delay 0 every 1 check yes

minimize        1.0e-4 1.0e-6 100 1000

neighbor        2.0 bin
neigh_modify    delay 1 check yes

############################################################ GROUPS

group           water type 1
group           substrate type 2
group           upperwall type 3

region          freezeAtom block INF INF INF INF 0 13 units box
group           freezeWall region freezeAtom
group           mobWall subtract substrate freezeWall   ### substrate of which part is applied thermostat

region          freezeUPAtom block INF INF INF INF 286 300 units box
group           freezeUPWall region freezeUPAtom
group           mobUPWall subtract upperwall freezeUPWall   ### upper wall of which part is applied thermostat

############################################################   COMPUTES

compute         Tw water temp/com
compute         Pliquid water pe/atom
compute         Pw water reduce sum c_Pliquid
compute         Kliquid water ke/atom
compute         Kw water reduce sum c_Kliquid

fix             1 substrate setforce 0.0 0.0 0.0        ### constraint on substrate
fix             2 upperwall setforce 0.0 0.0 NULL       ### constraint on topmost wall, allow longitudinal moving

############################################################   ENSEMBLE

fix             upperwallNVE upperwall nve
velocity        water create 290.0 54258 mom yes rot yes dist gaussian
fix             waterNVT water nvt temp 290.0 290.0 500.0 tchain 10  ### equilibrium at 290 K

############################################################   OUTPUT
timestep        5.0

thermo_style    custom step c_Tw temp c_Pw c_Kw pe etotal vol press lx ly lz
thermo          1000
thermo_modify   flush yes

fix             writeFile all ave/time 1 1 1000 c_Tw c_Pw c_Kw file equil.txt
dump            1 all custom 100000 equil.lammpstrj id type mol q x y z vx vy vz

run             2000000  ### 10 ns
write_restart   restart.*.equil

unfix           upperwallNVE
unfix           waterNVT
undump          1
unfix           1
unfix           2
