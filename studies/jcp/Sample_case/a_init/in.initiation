#########################################################################################
log        		log.initiation
#########################################################################################
# mW model setup, LAMMPS

units 			real					
dimension		3
boundary		p p p					
atom_style		full

processors      1 * *

############################################################ INITIAL CONFIG

region         box block -40 150 0.0 82.7316 0.0 85.977 units box
region         boxWater block 9.0 100.0 0.0 82.7316  0.0 85.977  units box
region         boxWall block -8.0 6.0 -0.1 82.7316  -0.1 85.977 units box
create_box     2 box
lattice        diamond 7
create_atoms   1 region boxWater
mass           1 18.015
lattice        fcc 3.9 orient x 1 1 1 orient y 1 -1 0 orient z 1 1 -2
create_atoms   2 region boxWall
mass           2 195.084

lattice        none 1.0

############################################################ INTERACTION

pair_style		    hybrid lj/cut 13.0 sw	

pair_coeff		    * * sw mW.sw mW NULL
pair_coeff   		1 2 lj/cut 1.37 2.34            ###  adhesion work: 6.44 kcal/mole
pair_coeff   		2 2 lj/cut 0.0 2.4710

pair_modify	        shift yes mix arithmetic

neighbor		    2.0 bin					
neigh_modify		delay 1 check yes

write_data          data.nanofilm



